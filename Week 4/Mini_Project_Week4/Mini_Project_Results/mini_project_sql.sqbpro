-- Q1. INTERMEDIATE SQL QUERIES
-- =========================================

-- 1. Top 10 customers by revenue
SELECT 
    customer_id,
    SUM(total_usd) AS revenue
FROM orders
GROUP BY customer_id
ORDER BY revenue DESC
LIMIT 10;


-- 2. Month-over-month sales growth
SELECT
    strftime('%Y-%m', order_date) AS month,
    SUM(total_usd) AS sales,
    LAG(SUM(total_usd)) OVER (
        ORDER BY strftime('%Y-%m', order_date)
    ) AS previous_month
FROM orders
GROUP BY month;


-- 3. Customers who ordered in consecutive months ??????
WITH months AS (
    SELECT DISTINCT
        customer_id,
        strftime('%Y-%m', order_date) AS month
    FROM orders
)
SELECT 
    customer_id,
    month
FROM (
    SELECT
        customer_id,
        month,
        LAG(month) OVER (
            PARTITION BY customer_id
            ORDER BY month)
    FROM months
)
;


-- 4. Products never ordered
SELECT 
    p.product_id,
    p.product_name
FROM products p
LEFT JOIN order_items oi
    ON p.product_id = oi.product_id
WHERE oi.product_id IS NULL;


-- 5. Revenue contribution percentage by category
SELECT
    p.category,
    SUM(oi.line_total_usd) * 100.0 / 
		(SELECT SUM(line_total_usd)
        FROM order_items
    ) AS percentage
FROM products p
JOIN order_items oi
    ON p.product_id = oi.product_id
GROUP BY p.category;


-- Q2. ADVANCED SQL TASKS
-- =========================================

-- 1. Rank customers based on total revenue
SELECT
    customer_id,
    SUM(total_usd) AS revenue,
    RANK() OVER (
        ORDER BY SUM(total_usd) DESC
    ) AS ranking
FROM orders
GROUP BY customer_id;


-- 2. Running total sales by month
WITH monthly_sales AS (
    SELECT
        strftime('%Y-%m', order_date) AS month,
        SUM(total_usd) AS sales
    FROM orders
    GROUP BY month
)
SELECT
    month,
    sales,
    SUM(sales) OVER (
        ORDER BY month
    ) AS running_total
FROM monthly_sales;

-- 3. Highest selling product per category ??????
WITH product_sales AS (
    SELECT
        p.category,
        p.product_name,
        SUM(oi.quantity) AS total_sales
    FROM products p
    JOIN order_items oi
        ON p.product_id = oi.product_id
    GROUP BY p.category, p.product_name
)
SELECT
    category,
    product_name,
    total_sales
FROM (
    SELECT
        *,
        RANK() OVER (
            PARTITION BY category
            ORDER BY total_sales DESC
        ) AS ranking
    FROM product_sales
)
WHERE ranking = 1;


-- 4. 7-day rolling average sales ??????
SELECT
    date(order_date) AS day,
    SUM(total_usd) AS sales,
    AVG(SUM(total_usd)) OVER (
        ORDER BY date(order_date)
        ROWS BETWEEN 6 PRECEDING AND CURRENT ROW
    ) AS rolling_avg
FROM orders
GROUP BY day;</sql><current_tab id="0"/></tab_sql></sqlb_project>
